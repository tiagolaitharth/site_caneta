---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
---

<Layout title="Catálogo de Canetas Premium | ARTOOLS" description="Explore nove modelos de canetas ARTOOLS com diferentes materiais, acabamentos, pesos e especificações.">
  <main class="catalog">
    <header class="catalog-heading">
      <span class="catalog-kicker">Catálogo 2026</span>
      <h1>Nove instrumentos.<br /><span>Nove formas de criar.</span></h1>
      <p>
        Uma coleção de canetas concebidas para diferentes ritmos,
        materiais e maneiras de transformar ideias em traços.
      </p>
    </header>

    <section class="catalog-grid" aria-label="Canetas da coleção">
      {products.map((product, index) => (
        <ProductCard index={index + 1} priority={index === 0} {...product} />
      ))}
    </section>
  </main>
</Layout>

<style>
  .catalog {
    min-height: 100svh;
    padding: clamp(136px, 15vw, 210px) clamp(20px, 5vw, 78px) clamp(90px, 10vw, 150px);
    background:
      radial-gradient(circle at 82% 4%, rgba(255, 255, 255, .96), transparent 28%),
      var(--paper);
  }

  .catalog-heading,
  .catalog-grid {
    width: min(100%, 1440px);
    margin-inline: auto;
  }

  .catalog-heading {
    max-width: 1440px;
    margin-bottom: clamp(62px, 8vw, 112px);
  }

  .catalog-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 23px;
    color: var(--muted);
    font: 500 10px "JetBrains Mono", monospace;
    letter-spacing: .18em;
    text-transform: uppercase;
  }

  .catalog-kicker::before {
    content: "";
    width: 8px;
    height: 8px;
    border: 1px solid currentColor;
    border-radius: 50%;
  }

  h1 {
    max-width: 1020px;
    margin: 0;
    opacity: 0;
    transform: translateY(28px);
    animation: catalogFadeIn .9s .12s var(--ease) forwards;
    color: var(--ink);
    font-family: "Inter Tight", Inter, sans-serif;
    font-size: clamp(58px, 8vw, 126px);
    font-weight: 620;
    line-height: .86;
    letter-spacing: -.072em;
  }

  h1 span {
    color: #9b9c96;
    font-weight: 500;
  }

  .catalog-heading p {
    max-width: 580px;
    margin: 30px 0 0;
    opacity: 0;
    transform: translateY(20px);
    animation: catalogFadeIn .85s .34s var(--ease) forwards;
    color: #63645e;
    font-size: clamp(14px, 1.15vw, 17px);
    line-height: 1.7;
  }

  .catalog-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
  }

  @keyframes catalogFadeIn {
    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    h1,
    .catalog-heading p {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }

  @media (max-width: 980px) {
    .catalog-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .catalog {
      padding-inline: 16px;
    }

    .catalog-grid {
      grid-template-columns: 1fr;
    }

    h1 {
      font-size: clamp(52px, 16vw, 78px);
    }
  }
</style>
