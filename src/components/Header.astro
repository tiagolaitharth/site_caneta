---
const links = [
  { href: '/', label: 'Início', section: '/' },
  { href: '/catalogo/', label: 'Catálogo', section: '/catalogo' },
  { href: '/produtos/6061-pearl/', label: 'Produto', section: '/produtos' },
];

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
---

<header class="topbar" aria-label="Navegação principal">
  <a class="brand" href="/" aria-label="ArtTools — início">
    <span class="brand-mark" aria-hidden="true">A</span>
    <span class="brand-name">ARTOOLS</span>
  </a>

  <nav class="nav" aria-label="Páginas do site">
    {links.map(({ href, label, section }) => {
      const isActive = section === '/' ? currentPath === '/' : currentPath.startsWith(section);
      return (
        <a
          href={href}
          class:list={{ active: isActive }}
          aria-current={isActive ? 'page' : undefined}
        >
          {label}
        </a>
      );
    })}
  </nav>

  <div class="mode"><i aria-hidden="true"></i>edição especial</div>
</header>

<style>
  .topbar {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: 74px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 clamp(20px, 4vw, 68px);
    border-bottom: 1px solid var(--line, #d4d4cc);
    background: linear-gradient(to bottom, #f4f4eef2, #f4f4ee92, transparent);
    backdrop-filter: blur(5px);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--ink, #090909);
    font-size: 17px;
    font-weight: 800;
    letter-spacing: -.08em;
    text-decoration: none;
  }

  .brand-mark {
    width: 25px;
    height: 25px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    color: var(--white, #fff);
    background: var(--ink, #090909);
    font-size: 14px;
    transition: transform .55s var(--ease, cubic-bezier(.16, 1, .3, 1));
  }

  .brand:hover .brand-mark {
    transform: rotate(180deg);
  }

  .nav {
    position: absolute;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 30px;
    transform: translateX(-50%);
  }

  .nav a {
    position: relative;
    padding: 8px 0;
    color: var(--muted, #75756f);
    font: 500 10px "JetBrains Mono", monospace;
    letter-spacing: .12em;
    text-decoration: none;
    text-transform: uppercase;
    transition: color .3s ease;
  }

  .nav a.active::before {
    content: "";
    position: absolute;
    top: -3px;
    left: 50%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--ink, #090909);
    transform: translateX(-50%);
    box-shadow: 0 0 0 0 rgba(9, 9, 9, .24);
    animation: activePagePulse 2.2s var(--ease, cubic-bezier(.16, 1, .3, 1)) infinite;
  }

  .nav a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: 2px;
    left: 0;
    height: 1px;
    background: var(--ink, #090909);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .35s var(--ease, cubic-bezier(.16, 1, .3, 1));
  }

  .nav a:hover,
  .nav a:focus-visible,
  .nav a.active {
    color: var(--ink, #090909);
  }

  .nav a:hover::after,
  .nav a:focus-visible::after,
  .nav a.active::after {
    transform: scaleX(1);
  }

  .nav a.active {
    font-weight: 600;
  }

  .mode {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 8px 11px;
    border: 1px solid var(--line, #d4d4cc);
    border-radius: 999px;
    color: var(--muted, #75756f);
    font: 500 9px "JetBrains Mono", monospace;
    letter-spacing: .11em;
    text-transform: uppercase;
  }

  .mode i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--signal, #dfff00);
    box-shadow: 0 0 10px var(--signal, #dfff00);
    animation: pulse 1.7s infinite;
  }

  @keyframes activePagePulse {
    0%, 100% {
      box-shadow: 0 0 0 0 rgba(9, 9, 9, .24);
    }
    50% {
      box-shadow: 0 0 0 5px rgba(9, 9, 9, 0);
    }
  }

  @keyframes pulse {
    50% {
      opacity: .45;
      transform: scale(.55);
    }
  }

  @media (max-width: 850px) {
    .nav {
      position: static;
      gap: clamp(14px, 4vw, 24px);
      transform: none;
    }

    .mode {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .topbar {
      height: 63px;
      padding: 0 18px;
    }

    .brand-name {
      display: none;
    }

    .nav {
      gap: 14px;
    }

    .nav a {
      font-size: 8px;
      letter-spacing: .08em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .brand-mark,
    .mode i,
    .nav a.active::before {
      animation-duration: .01ms;
      animation-iteration-count: 1;
      transition-duration: .01ms;
    }
  }
</style>
