---
interface Props {
  title: string;
  description: string;
  delay?: number;
}

const {
  title,
  description,
  delay = 0,
} = Astro.props;
---

<article class="story-feature story-reveal" style={`--reveal-delay:${delay}ms`}>
  <span class="feature-number" aria-hidden="true"></span>
  <div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
</article>

<style>
  .story-feature {
    position: relative;
    display: grid;
    grid-template-columns: 42px 1fr;
    gap: 14px;
    padding: clamp(26px, 3.4vw, 44px) 0;
    border-top: 1px solid var(--line);
    transition: padding .45s var(--ease);
  }

  .story-feature:last-child {
    border-bottom: 1px solid var(--line);
  }

  .story-feature::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--ink);
    transition: width .6s var(--ease);
  }

  .story-feature:hover {
    padding-left: 12px;
  }

  .story-feature:hover::before {
    width: 100%;
  }

  .feature-number {
    padding-top: 5px;
    color: #999;
    font: 500 10px "JetBrains Mono", monospace;
  }

  h3 {
    margin: 0 0 10px;
    font-family: "Inter Tight", Inter, sans-serif;
    font-size: clamp(24px, 2.1vw, 34px);
    font-weight: 600;
    line-height: 1;
    letter-spacing: -.045em;
  }

  p {
    max-width: 440px;
    margin: 0;
    color: #6c6c67;
    font-size: 14px;
    line-height: 1.65;
  }

  @media (max-width: 980px) {
    .story-feature {
      grid-template-columns: 32px 1fr;
      padding: 30px 18px 30px 0;
      border-bottom: 1px solid var(--line);
    }
  }

  @media (max-width: 680px) {
    .story-feature {
      padding: 28px 0;
    }

    .story-feature:hover {
      padding-left: 8px;
    }
  }
</style>
