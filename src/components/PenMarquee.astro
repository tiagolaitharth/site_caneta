---
const words = [
  'Precisão',
  'Movimento',
  'Traço',
  'Ideias',
  'Expressão',
  'Ritmo',
  'Criação',
  'Fluidez',
];

const description = words.join(', ');
---

<div class="pen-marquee" role="img" aria-label={description}>
  <div class="marquee-track">
    <div class="marquee-line" aria-hidden="true">
      {words.map((word) => (
        <span class="marquee-item">
          <span class="marquee-word">{word}</span>
          <span class="marquee-divider">—</span>
        </span>
      ))}
    </div>
    <div class="marquee-line" aria-hidden="true">
      {words.map((word) => (
        <span class="marquee-item">
          <span class="marquee-word">{word}</span>
          <span class="marquee-divider">—</span>
        </span>
      ))}
    </div>
  </div>
</div>

<style>
  .pen-marquee {
    position: relative;
    z-index: 2;
    width: 100%;
    flex: 0 0 auto;
    height: clamp(58px, 6.5vw, 88px);
    overflow: hidden;
    pointer-events: none;
    opacity: .9;
    border-top: 1px solid rgba(255, 255, 255, .12);
    border-bottom: 1px solid rgba(255, 255, 255, .12);
    background: linear-gradient(90deg, rgba(8, 8, 7, .72), rgba(16, 16, 14, .82) 50%, rgba(8, 8, 7, .72));
    backdrop-filter: blur(8px);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }

  .marquee-track {
    width: max-content;
    height: 100%;
    display: flex;
    align-items: center;
    white-space: nowrap;
    will-change: transform;
    animation: marquee 42s linear infinite;
  }

  .marquee-line {
    height: 100%;
    display: flex;
    flex-shrink: 0;
    align-items: center;
    white-space: nowrap;
  }

  .marquee-item {
    display: inline-flex;
    align-items: center;
    gap: clamp(20px, 2.3vw, 38px);
    padding-right: clamp(20px, 2.3vw, 38px);
    white-space: nowrap;
  }

  .marquee-word {
    color: rgba(255, 255, 255, .78);
    font-family: "Cormorant Garamond", Georgia, serif;
    font-size: clamp(38px, 5vw, 76px);
    font-style: italic;
    font-weight: 500;
    line-height: .9;
    letter-spacing: -.025em;
    text-shadow: 0 8px 30px rgba(0, 0, 0, .2);
  }

  .marquee-divider {
    color: rgba(255, 255, 255, .25);
    font-family: "Inter", sans-serif;
    font-size: clamp(12px, 1vw, 16px);
    font-weight: 400;
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 680px) {
    .pen-marquee {
      height: 54px;
    }

    .marquee-track {
      animation-duration: 30s;
    }

    .marquee-word {
      font-size: 38px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      transform: translateX(-8%);
    }
  }
</style>
