---
const specs = [
  { label: 'Comprimento', value: '142 mm' },
  { label: 'Diâmetro', value: '9,6 mm' },
  { label: 'Peso total', value: '20 g' },
  { label: 'Esfera da ponta', value: '0,7 mm' },
  { label: 'Autonomia do refil', value: '2.500 m' },
  { label: 'Centro de gravidade', value: '52%' },
  { label: 'Usinagem CNC', value: '5 eixos' },
  { label: 'Liga de alumínio', value: '6061-T6' },
  { label: 'Textura micro-grip', value: 'Ra 0,8 μm' },
  { label: 'Tolerância mecânica', value: '±0,01 mm' },
  { label: 'Garantia do chassi', value: 'Vitalícia' },
];
---

<section class="technical-specs" aria-labelledby="technical-specs-title">
  <div class="specs-shell">
    <header class="specs-heading specs-reveal">
      <span class="specs-kicker">Especificações</span>
      <h2 id="technical-specs-title">Artools Precision 6061</h2>
      <p>
        Um instrumento de escrita desenvolvido em alumínio aeroespacial,
        equilibrado para oferecer controle e precisão em cada traço.
      </p>
    </header>

    <dl class="specs-list">
      {specs.map(({ label, value }, index) => (
        <div class="spec-row specs-reveal" style={`--reveal-delay:${index * 45}ms`}>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .technical-specs {
    --spec-text: #d8d8d3;
    --spec-muted: #7f807b;
    --spec-line: rgba(255, 255, 255, .105);
    position: relative;
    z-index: 2;
    overflow: hidden;
    padding: clamp(64px, 7vw, 100px) clamp(22px, 4vw, 48px) clamp(70px, 8vw, 112px);
    color: var(--spec-text);
    background:
      radial-gradient(circle at 75% -20%, rgba(255, 255, 255, .035), transparent 36%),
      #050605;
    border-top: 1px solid rgba(255, 255, 255, .13);
  }

  .technical-specs::before {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    opacity: .18;
    background-image:
      linear-gradient(rgba(255, 255, 255, .012) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, .012) 1px, transparent 1px);
    background-size: 96px 96px;
  }

  .specs-shell {
    position: relative;
    width: min(100%, 1440px);
    margin-inline: auto;
  }

  .specs-heading {
    max-width: 780px;
    margin-bottom: clamp(44px, 5vw, 68px);
    text-align: left;
  }

  .specs-kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
    color: var(--spec-muted);
    font: 600 9px "JetBrains Mono", monospace;
    letter-spacing: .22em;
    text-transform: uppercase;
  }

  .specs-kicker::before {
    content: "";
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
  }

  h2 {
    margin: 0;
    color: var(--spec-text);
    font-family: "Inter Tight", Inter, sans-serif;
    font-size: clamp(38px, 5vw, 70px);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -.045em;
    text-align: left;
  }

  .specs-heading p {
    max-width: 720px;
    margin: 20px 0 0;
    color: var(--spec-muted);
    font-size: clamp(12px, 1.15vw, 15px);
    line-height: 1.65;
  }

  .specs-list {
    margin: 0;
    border-bottom: 1px solid var(--spec-line);
  }

  .spec-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    min-height: 52px;
    padding: 0 14px;
    border-top: 1px solid var(--spec-line);
    transition: background .3s ease, padding .3s var(--ease);
  }

  .spec-row:hover {
    padding-inline: 20px;
    background: rgba(255, 255, 255, .025);
  }

  dt,
  dd {
    margin: 0;
    color: var(--spec-text);
    font-family: "JetBrains Mono", monospace;
  }

  dt {
    font-size: clamp(8px, .72vw, 10px);
    font-weight: 600;
    letter-spacing: .12em;
    text-transform: uppercase;
  }

  dd {
    font-size: clamp(13px, 1.25vw, 17px);
    font-weight: 500;
    letter-spacing: .025em;
    text-align: right;
    white-space: nowrap;
  }

  .specs-reveal {
    opacity: 0;
    filter: blur(4px);
    transform: translateY(16px);
    transition:
      opacity .7s var(--ease),
      filter .7s var(--ease),
      transform .7s var(--ease);
    transition-delay: var(--reveal-delay, 0ms);
  }

  .specs-reveal.is-visible {
    opacity: 1;
    filter: blur(0);
    transform: translateY(0);
  }

  @media (max-width: 680px) {
    .technical-specs {
      padding: 60px 16px 76px;
    }

    .specs-heading {
      margin-bottom: 40px;
    }

    h2 {
      font-size: clamp(36px, 11vw, 52px);
    }

    .specs-heading p {
      font-size: 12px;
    }

    .spec-row {
      min-height: 50px;
      padding-inline: 8px;
    }

    .spec-row:hover {
      padding-inline: 10px;
    }

    dt {
      font-size: 8px;
      letter-spacing: .08em;
    }

    dd {
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .specs-reveal {
      opacity: 1;
      filter: none;
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  const technicalSection = document.querySelector('.technical-specs');

  if (technicalSection) {
    const revealItems = technicalSection.querySelectorAll('.specs-reveal');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (reduceMotion) {
      revealItems.forEach((item) => item.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });

      revealItems.forEach((item) => observer.observe(item));
    }
  }
</script>
